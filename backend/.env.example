# ── Provider ──────────────────────────────────────────────────────────────────
# "ollama" for local (default) | "groq" | "together" | "openrouter" | "openai"
PROVIDER=ollama

# Required when PROVIDER != ollama
# API_KEY=your_api_key_here
# API_BASE_URL=                     # auto-set from PROVIDER, override if needed

# ── Models ────────────────────────────────────────────────────────────────────
# Local (Ollama)
PRIMARY_MODEL=qwen3:4b
VERIFIER_MODEL=phi4-mini
EMBEDDING_MODEL=nomic-embed-text

# Cloud examples (uncomment and set PROVIDER above):
# Groq (free tier, very fast):
#   PRIMARY_MODEL=llama-3.1-8b-instant
# Together AI (has Qwen models):
#   PRIMARY_MODEL=Qwen/Qwen2.5-7B-Instruct-Turbo
# OpenRouter (routes to many providers):
#   PRIMARY_MODEL=qwen/qwen-2.5-7b-instruct

# ── Embeddings ────────────────────────────────────────────────────────────────
# "ollama" | "together" | "jina" | "openai"
EMBEDDING_PROVIDER=ollama
# EMBEDDING_API_KEY=                # if different from API_KEY
# EMBEDDING_MODEL=nomic-embed-text  # mapped to provider equivalent automatically

# ── Ollama (local only) ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# For Qdrant Cloud:
# QDRANT_HOST=xyz-abc.eu-central.aws.cloud.qdrant.io
# QDRANT_PORT=6333
# QDRANT_API_KEY=your_qdrant_api_key

QDRANT_COLLECTION=aletheia_knowledge
QDRANT_MEMORY_COLLECTION=aletheia_memory

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./aletheia.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your Vercel frontend URL for production:
# CORS_ORIGINS=["https://aletheia.vercel.app","http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000"]

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K_CHUNKS=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64
LOKI_MAX_CLAIMS=8
VERBALIZED_CONF_WEIGHT=0.40
HIGH_CONFIDENCE_THRESHOLD=0.75
LOW_CONFIDENCE_THRESHOLD=0.40
